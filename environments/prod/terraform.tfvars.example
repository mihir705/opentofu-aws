# --- Security Groups (see modules/security-group/terraform.tfvars.example) ---
security_groups = {
  app = {
    name        = "my-company-app-prod"
    vpc_key     = "main"
    description = "Application instance security group"

    ingress_rules = [
      {
        description = "HTTP from VPC"
        protocol    = "tcp"
        from_port   = 8080
        to_port     = 8080
        cidr_blocks = ["10.0.0.0/16"]
      }
    ]

    tags = {
      Purpose = "app"
    }
  }
}
