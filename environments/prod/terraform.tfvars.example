# Copy this file to terraform.tfvars and update values for your environment.
# cp terraform.tfvars.example terraform.tfvars
#
# Module-specific examples (copy blocks from these into this file):
#   modules/s3/terraform.tfvars.example
#   modules/secrets-manager/terraform.tfvars.example
#   modules/kms/terraform.tfvars.example
#   modules/lambda/terraform.tfvars.example
#   modules/cloudfront/terraform.tfvars.example
#   modules/vpc/terraform.tfvars.example
#   modules/alb/terraform.tfvars.example
#   modules/nlb/terraform.tfvars.example
#   modules/security-group/terraform.tfvars.example
#   modules/codebuild/terraform.tfvars.example
#   modules/codepipeline/terraform.tfvars.example
#   modules/iam-role/terraform.tfvars.example
#   modules/apigateway/terraform.tfvars.example
#   modules/sns/terraform.tfvars.example
#   modules/sqs/terraform.tfvars.example
#   modules/eks/terraform.tfvars.example
#
# Omit any block you do not need. No empty {} required.

aws_region         = "ap-south-1"
aws_replica_region = "us-east-1"

default_tags = {
  Environment = "prod"
  ManagedBy   = "opentofu"
  Project     = "opentofu-aws"
}

# --- S3 (see modules/s3/terraform.tfvars.example) ---
buckets = {
  app-data = {
    bucket_name        = "my-company-app-data-prod"
    versioning_enabled = true

    tags = {
      Purpose = "application-data"
    }
  }
}

# --- Secrets Manager (see modules/secrets-manager/terraform.tfvars.example) ---
secrets = {
  app-config = {
    name        = "my-company/app/config/prod"
    description = "Application configuration secret"

    tags = {
      Purpose = "app-config"
    }
  }
}

# --- KMS (see modules/kms/terraform.tfvars.example) ---
kms_keys = {
  app-encryption = {
    description         = "Application data encryption key"
    enable_key_rotation = true
    allowed_services    = ["s3", "secretsmanager"]
    aliases             = ["my-company/app/prod"]

    tags = {
      Purpose = "app-encryption"
    }
  }
}

# --- Lambda (see modules/lambda/terraform.tfvars.example) ---
lambda_functions = {
  api-handler = {
    function_name      = "my-company-api-handler-prod"
    runtime            = "python3.12"
    handler            = "app.handler"
    s3_bucket          = "my-company-lambda-artifacts-prod"
    s3_key             = "api-handler/latest.zip"
    package_source_dir = "lambda-src/api-handler"

    tags = {
      Purpose = "api-handler"
    }
  }
}

# --- CloudFront (see modules/cloudfront/terraform.tfvars.example) ---
cloudfront_distributions = {
  static-site = {
    origin_bucket_name  = "my-company-static-site-prod"
    default_root_object = "index.html"
    spa_fallback        = true

    tags = {
      Purpose = "static-site"
    }
  }
}

# --- VPC (see modules/vpc/terraform.tfvars.example) ---
vpcs = {
  main = {
    name       = "my-company-prod"
    cidr_block = "10.0.0.0/16"

    public_subnets = {
      az-a = { availability_zone = "ap-south-1a", cidr_block = "10.0.1.0/24" }
      az-b = { availability_zone = "ap-south-1b", cidr_block = "10.0.2.0/24" }
    }

    private_subnets = {
      az-a = { availability_zone = "ap-south-1a", cidr_block = "10.0.11.0/24" }
      az-b = { availability_zone = "ap-south-1b", cidr_block = "10.0.12.0/24" }
    }

    tags = {
      Purpose = "main-network"
    }
  }
}

# --- ALB (see modules/alb/terraform.tfvars.example) ---
load_balancers = {
  public = {
    name    = "my-company-public-alb-prod"
    vpc_key = "main"

    target_groups = {
      app = {
        port              = 80
        protocol          = "HTTP"
        target_type       = "ip"
        health_check_path = "/health"
      }
    }

    listeners = {
      http = {
        port     = 80
        protocol = "HTTP"
        default_action = {
          type             = "forward"
          target_group_key = "app"
        }
      }
    }

    tags = {
      Purpose = "public-alb"
    }
  }
}

