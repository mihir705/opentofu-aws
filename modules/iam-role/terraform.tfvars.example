# IAM Role module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/iam-role/README.md

# ---------------------------------------------------------------------------
# Lambda execution role with AWS managed policy
# ---------------------------------------------------------------------------

iam_roles = {
  lambda-exec = {
    name           = "my-company-lambda-exec-prod"
    description    = "Lambda execution role"
    trust_services = ["lambda.amazonaws.com"]

    managed_policy_arns = [
      "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
    ]

    tags = {
      Purpose = "lambda-execution"
    }
  }
}

