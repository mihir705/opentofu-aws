# CodeBuild module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/codebuild/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# GitHub source with managed IAM role and CloudWatch logs
# ---------------------------------------------------------------------------

codebuild_projects = {
  api = {
    name        = "my-company-api-build-prod"
    description = "Build and test API service"

    source = {
      type                = "GITHUB"
      location            = "https://github.com/my-org/my-api.git"
      buildspec           = "buildspec.yml"
      git_clone_depth     = 1
      report_build_status = true
    }

    environment = {
      image        = "aws/codebuild/standard:7.0"
      compute_type = "BUILD_GENERAL1_SMALL"
      type         = "LINUX_CONTAINER"

      environment_variables = [
        {
          name  = "ENVIRONMENT"
          value = "prod"
        }
      ]
    }

    tags = {
      Purpose = "api-build"
    }
  }
}

