# SQS module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/sqs/README.md

# ---------------------------------------------------------------------------
# Standard queue with SSE-SQS and dead-letter queue
# ---------------------------------------------------------------------------

sqs_queues = {
  app-jobs = {
    name                       = "my-company-app-jobs-prod"
    visibility_timeout_seconds = 60
    receive_wait_time_seconds  = 20
    create_dlq                 = true
    max_receive_count          = 5

    tags = {
      Purpose = "background-jobs"
    }
  }
}

