# KMS module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/kms/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region         = "ap-south-1"
#   aws_replica_region = "us-east-1"   # only when using KMS replica keys
#   default_tags       = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# Basic — application encryption key for S3 and Secrets Manager
# ---------------------------------------------------------------------------

kms_keys = {
  app-encryption = {
    description         = "Application data encryption key"
    enable_key_rotation = true
    allowed_services    = ["s3", "secretsmanager"]
    aliases             = ["my-company/app/prod"]

    tags = {
      Purpose = "app-encryption"
    }
  }
}

# ---------------------------------------------------------------------------
# Multi-Region key with DR replica (requires aws_replica_region provider)
# ---------------------------------------------------------------------------
# kms_keys = {
#   global-encryption = {
#     description         = "Multi-Region encryption key with DR replica"
#     multi_region        = true
#     replica_region      = "us-east-1"
#     enable_key_rotation = true
#     allowed_services    = ["secretsmanager"]
#     aliases             = ["my-company/global/prod"]
#
#     tags = {
#       Purpose = "global-encryption"
#     }
#   }
# }

# ---------------------------------------------------------------------------
# Custom policy statements (merged into default root policy)
