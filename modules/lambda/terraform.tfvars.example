# Lambda module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/lambda/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }
#
# Zip deployments: S3 bucket must be in the same region as aws_region.
# Use package_source_dir to let lambda_packages.tf zip and upload automatically.

# ---------------------------------------------------------------------------
# Basic — Python API handler (Terraform builds zip and uploads to S3)
# ---------------------------------------------------------------------------

buckets = {
  lambda-artifacts = {
    bucket_name        = "my-company-lambda-artifacts-prod"
    versioning_enabled = true

    tags = {
      Purpose = "lambda-artifacts"
    }
  }
}

lambda_functions = {
  api-handler = {
    function_name      = "my-company-api-handler-prod"
    description        = "API request handler"
    runtime            = "python3.12"
    handler            = "app.handler"
    s3_bucket          = "my-company-lambda-artifacts-prod"
    s3_key             = "api-handler/latest.zip"
    package_source_dir = "lambda-src/api-handler"
    memory_size        = 256
    timeout            = 30

    environment_variables = {
      ENV = "prod"
    }

    tags = {
      Purpose = "api-handler"
    }
  }
}

