# CodePipeline module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/codepipeline/README.md
#
# Prerequisites:
#   - S3 bucket for artifacts (buckets block or artifact_bucket)
#   - CodeStar connection ARN for GitHub/GitLab sources
#   - CodeBuild project for build stage (optional codebuild_project_key)

# ---------------------------------------------------------------------------
# GitHub Source → CodeBuild (V2 pipeline)
# ---------------------------------------------------------------------------

# buckets = {
#   pipeline-artifacts = {
#     bucket_name = "my-company-pipeline-artifacts-prod"
#     tags = { Purpose = "pipeline-artifacts" }
#   }
# }
#
# codebuild_projects = {
#   api = {
#     name = "my-company-api-build-prod"
#     source = { type = "CODEPIPELINE" }
#     artifacts = { type = "CODEPIPELINE" }
#     environment = { image = "aws/codebuild/standard:7.0" }
#   }
# }
#
# codepipelines = {
#   api = {
#     name                = "my-company-api-pipeline-prod"
#     artifact_bucket_key = "pipeline-artifacts"
#
#     stages = [
#       {
#         name = "Source"
#         actions = [
