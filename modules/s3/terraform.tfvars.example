# ---------------------------------------------------------------------------
# Server access logging
# ---------------------------------------------------------------------------
# Target bucket must exist and grant write access to the S3 logging service.
#
# buckets = {
#   app-data = {
#     bucket_name        = "my-company-app-data-prod"
#     versioning_enabled = true
#
#     access_logging = {
#       target_bucket = "my-company-access-logs-prod"
#       target_prefix = "app-data/"
#     }
#
#     tags = {
#       Purpose = "application-data"
#     }
#   }
# }

