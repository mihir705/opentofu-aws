# S3 module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/s3/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# Basic — application data bucket with versioning
# ---------------------------------------------------------------------------

buckets = {
  app-data = {
    bucket_name        = "my-company-app-data-prod"
    versioning_enabled = true

    tags = {
      Purpose = "application-data"
    }
  }
}

# ---------------------------------------------------------------------------
# Lambda deployment artifacts (same region as aws_region)
# ---------------------------------------------------------------------------
# buckets = {
#   lambda-artifacts = {
#     bucket_name        = "my-company-lambda-artifacts-prod"
#     versioning_enabled = true
#
#     tags = {
#       Purpose = "lambda-artifacts"
#     }
#   }
# }

