# Security Group module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/security-group/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# App servers — allow HTTP from ALB security group, SSH from VPC
# ---------------------------------------------------------------------------

security_groups = {
  app = {
    name        = "my-company-app-prod"
    vpc_key     = "main"
    description = "Application instance security group"

    ingress_rules = [
      {
        description = "HTTP from VPC"
        protocol    = "tcp"
        from_port   = 8080
        to_port     = 8080
        cidr_blocks = ["10.0.0.0/16"]
      }
    ]

    tags = {
      Purpose = "app"
    }
  }
}

# ---------------------------------------------------------------------------
# Allow traffic from another security group (e.g. ALB SG)
# ---------------------------------------------------------------------------
# security_groups = {
#   app = {
