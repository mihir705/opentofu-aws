# IAM User module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/iam-user/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# CI/CD user with customer-managed policy attachment
# ---------------------------------------------------------------------------

iam_policies = {
  deploy-read = {
    name        = "my-company-deploy-read-prod"
    description = "Read-only deploy artifacts access"
    policy_statements = [{
      effect    = "Allow"
      actions   = ["s3:GetObject", "s3:ListBucket"]
      resources = ["arn:aws:s3:::my-company-deploy-artifacts-prod", "arn:aws:s3:::my-company-deploy-artifacts-prod/*"]
    }]
    tags = { Purpose = "deploy-read" }
  }
}

iam_users = {
  ci-deploy = {
    name                = "my-company-ci-deploy-prod"
    managed_policy_keys = ["deploy-read"]

    tags = {
      Purpose = "ci-deploy"
    }
  }
}

