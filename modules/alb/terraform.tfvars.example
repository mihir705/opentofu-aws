# ALB module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/alb/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }
#
# ALB requires a VPC with at least two subnets. Use vpc_key to auto-wire from the VPC module.

# ---------------------------------------------------------------------------
# Internet-facing ALB with HTTP listener (fixed response placeholder)
# ---------------------------------------------------------------------------

load_balancers = {
  public = {
    name    = "my-company-public-alb-prod"
    vpc_key = "main"

    target_groups = {
      app = {
        port        = 80
        protocol    = "HTTP"
        target_type = "ip"
        health_check_path = "/health"
      }
    }

    listeners = {
      http = {
        port     = 80
        protocol = "HTTP"
        default_action = {
          type             = "forward"
          target_group_key = "app"
        }
      }
    }

    tags = {
      Purpose = "public-alb"
    }
  }
}

