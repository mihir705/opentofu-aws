# RDS module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/rds/README.md

# ---------------------------------------------------------------------------
# PostgreSQL in private subnets with AWS-managed master password
# ---------------------------------------------------------------------------

rds_instances = {
  app-db = {
    identifier     = "my-company-app-db-prod"
    engine         = "postgres"
    engine_version_lookup = {
      version = "16"
      latest  = true
    }
    instance_class = "db.t4g.micro"
    allocated_storage = 20
    username       = "dbadmin"
    manage_master_user_password = true

    db_name = "appdb"

    vpc_key     = "main"
    subnet_keys = ["az-a", "az-b"]
    security_group_keys = ["rds"]

    storage_encrypted = true
    multi_az          = false
    deletion_protection = true

    enabled_cloudwatch_logs_exports = ["postgresql"]

    tags = {
      Purpose = "application-database"
    }
  }
}

