# IAM Policy module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/iam-policy/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# S3 read-only policy attached to a role via managed_policy_keys
# ---------------------------------------------------------------------------

iam_policies = {
  app-s3-read = {
    name        = "my-company-app-s3-read-prod"
    description = "Read-only access to application data bucket"

    policy_statements = [
      {
        sid    = "S3AppDataRead"
        effect = "Allow"
        actions = [
          "s3:GetObject",
          "s3:ListBucket",
        ]
        resources = [
          "arn:aws:s3:::my-company-app-data-prod",
          "arn:aws:s3:::my-company-app-data-prod/*",
        ]
      }
    ]

    tags = {
      Purpose = "app-s3-read"
    }
  }
}

