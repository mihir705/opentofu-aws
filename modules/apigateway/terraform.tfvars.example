# API Gateway module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/apigateway/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# Lambda proxy HTTP API (requires lambda_functions block)
# ---------------------------------------------------------------------------

# lambda_functions = {
#   api-handler = {
#     function_name      = "my-company-api-handler-prod"
#     runtime            = "python3.12"
#     handler            = "app.handler"
#     s3_bucket          = "my-company-lambda-artifacts-prod"
#     s3_key             = "api-handler/latest.zip"
#     package_source_dir = "lambda-src/api-handler"
#     memory_size        = 256
#     timeout            = 30
#
#     tags = { Purpose = "api-handler" }
#   }
# }

api_gateways = {
  public-api = {
    name        = "my-company-public-api-prod"
    description = "Public HTTP API backed by Lambda"

    cors_configuration = {
      allow_methods = ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
      allow_origins = ["https://app.example.com"]
      allow_headers = ["content-type", "authorization", "x-api-key"]
      max_age       = 300
    }

    integrations = {
      lambda = {
        integration_type      = "AWS_PROXY"
        lambda_function_key   = "api-handler"
      }
    }

    routes = {
      catch-all = {
        route_key       = "$default"
        integration_key = "lambda"
      }
      health = {
        route_key       = "GET /health"
        integration_key = "lambda"
      }
    }

    stages = {
      default = {
        name        = "$default"
        auto_deploy = true
        default_route_settings = {
          detailed_metrics_enabled = true
          throttling_burst_limit   = 100
          throttling_rate_limit    = 50
        }
      }
    }

    tags = {
      Purpose = "public-api"
    }
  }
}

