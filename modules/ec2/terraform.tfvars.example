# EC2 module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/ec2/README.md

# ---------------------------------------------------------------------------
# Private app server in VPC with security group + IAM instance profile
# ---------------------------------------------------------------------------

ec2_instances = {
  app = {
    name          = "my-company-app-prod"
    instance_type = "t3.small"
    vpc_key       = "main"
    subnet_key    = "az-a"
    subnet_type   = "private"
    security_group_keys = ["app"]
    iam_role_key  = "app-ec2"

    ami_lookup = {
      owners = ["amazon"]
      filters = {
        name                = ["al2023-ami-*-kernel-*-x86_64"]
        virtualization-type = ["hvm"]
      }
    }

    # key_name = "my-company-prod" # optional — omit for keyless instances (use SSM Session Manager)

    root_block_device = {
      volume_size = 30
    }

    ignore_ami_changes = true
    volume_tags = {
      Backup = "daily"
    }

    monitoring = true

    tags = {
      Purpose = "application-server"
    }
  }
}

