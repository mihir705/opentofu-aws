# VPC module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/vpc/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }
#
# Creates: VPC, Internet Gateway, 2 public + 2 private subnets, route tables,
#          NAT gateway, public/private Network ACLs.

# ---------------------------------------------------------------------------
# Standard — 2 public + 2 private subnets, single NAT gateway
# ---------------------------------------------------------------------------

vpcs = {
  main = {
    name       = "my-company-prod"
    cidr_block = "10.0.0.0/16"

    public_subnets = {
      az-a = {
        availability_zone = "ap-south-1a"
        cidr_block        = "10.0.1.0/24"
      }
      az-b = {
        availability_zone = "ap-south-1b"
        cidr_block        = "10.0.2.0/24"
      }
    }

    private_subnets = {
      az-a = {
        availability_zone = "ap-south-1a"
        cidr_block        = "10.0.11.0/24"
      }
      az-b = {
        availability_zone = "ap-south-1b"
        cidr_block        = "10.0.12.0/24"
      }
    }

    tags = {
      Purpose = "main-network"
    }
  }
}

