# ECR module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/ecr/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# Basic application repository with lifecycle cleanup
# ---------------------------------------------------------------------------

ecr_repositories = {
  app = {
    name                 = "my-company-app-prod"
    image_tag_mutability = "IMMUTABLE"
    scan_on_push         = true

    lifecycle_rules = [
      {
        rule_priority = 1
        description   = "Keep last 30 images"
        tag_status    = "any"
        count_type    = "imageCountMoreThan"
        count_number  = 30
      }
    ]

    tags = {
      Purpose = "application-images"
    }
  }
}

