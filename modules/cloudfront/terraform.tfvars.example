#     default_root_object = "index.html"
#     spa_fallback        = true
#
#     aliases             = ["www.example.com", "example.com"]
#     acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/abcd1234-5678-90ab-cdef-1234567890ab"
#
#     tags = {
#       Purpose = "static-site"
#     }
#   }
# }

