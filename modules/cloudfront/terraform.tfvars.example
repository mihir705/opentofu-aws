# CloudFront module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/cloudfront/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }
#
# After apply, upload site files:
#   aws s3 sync ./dist s3://<origin_bucket_name>/

# ---------------------------------------------------------------------------
# Basic — static site with private S3 origin + SPA routing
# ---------------------------------------------------------------------------

cloudfront_distributions = {
  static-site = {
    distribution_comment = "Static website CDN"
    origin_bucket_name   = "my-company-static-site-prod"
    default_root_object  = "index.html"
    spa_fallback         = true

    tags = {
      Purpose = "static-site"
    }
  }
}

# ---------------------------------------------------------------------------
# Custom domain with ACM certificate (cert must be in us-east-1)
# ---------------------------------------------------------------------------
# cloudfront_distributions = {
#   static-site = {
