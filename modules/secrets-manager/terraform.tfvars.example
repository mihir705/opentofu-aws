# Secrets Manager module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/secrets-manager/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }
#
# Never commit real secret values to version control.

# ---------------------------------------------------------------------------
# Basic — empty secret (value set outside Terraform)
# ---------------------------------------------------------------------------

secrets = {
  app-config = {
    name        = "my-company/app/config/prod"
    description = "Application configuration secret"

    tags = {
      Purpose = "app-config"
    }
  }
}

# ---------------------------------------------------------------------------
# Generated random password (JSON with username + password)
# ---------------------------------------------------------------------------
# secrets = {
#   database-credentials = {
#     name_prefix = "my-company/database/credentials/prod-"
#     description = "Database credentials with generated password"
#
#     generate_random_password = {
#       length   = 32
#       username = "db_admin"
#     }
#
#     ignore_secret_changes = true
#
#     tags = {
#       Purpose = "database-credentials"
#     }
