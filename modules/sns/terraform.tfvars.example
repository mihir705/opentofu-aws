# SNS module — terraform.tfvars example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/sns/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }

# ---------------------------------------------------------------------------
# Standard topic with email subscription
# ---------------------------------------------------------------------------

sns_topics = {
  app-alerts = {
    name         = "my-company-app-alerts-prod"
    display_name = "Application Alerts"

    subscriptions = {
      ops-email = {
        protocol = "email"
        endpoint = "ops@example.com"
      }
    }

    tags = {
      Purpose = "app-alerts"
    }
  }
}

