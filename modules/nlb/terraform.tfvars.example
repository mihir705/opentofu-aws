# NLB module — terraform.tfvars.example
#
# Copy the blocks you need into environments/prod/terraform.tfvars
# Documentation: modules/nlb/README.md
#
# Required in terraform.tfvars (once per environment):
#   aws_region   = "ap-south-1"
#   default_tags = { Environment = "prod", ManagedBy = "opentofu" }
#
# NLB requires a VPC with at least two subnets. Use vpc_key to auto-wire from the VPC module.

# ---------------------------------------------------------------------------
# Internet-facing NLB with TCP listener
# ---------------------------------------------------------------------------

network_load_balancers = {
  public = {
    name    = "my-company-public-nlb-prod"
    vpc_key = "main"

    target_groups = {
      app = {
        port        = 8080
        protocol    = "TCP"
        target_type = "ip"
      }
    }

    listeners = {
      tcp = {
        port             = 8080
        protocol         = "TCP"
        target_group_key = "app"
      }
    }

    tags = {
      Purpose = "public-nlb"
    }
  }
}

